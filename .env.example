POSTGRES_PASSWORD=change-database-password
JWT_SECRET=replace-with-a-long-random-secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Public domain or public IP of the server, without https://
# Example: messenger.example.com
TURN_HOST=
TURN_PORT=3478
TURN_REALM=messenger.example.com
TURN_USERNAME=messenger
TURN_PASSWORD=replace-with-a-long-random-turn-password

# Public address used in generated temporary file links.
# Point this domain to the same web container/reverse proxy.
PUBLIC_SHARE_BASE_URL=https://files.igorson.xyz
SHARE_TTL_DAYS=30
